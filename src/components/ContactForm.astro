---
import Button from './Button.astro';
---
<form
  class="space-y-5"
  method="post"
  action="#"
  aria-label="Contact Silvia"
>
  <!--
    PLACEHOLDER: This form is not yet connected to a delivery service.
    Configure a form backend (e.g., Formspree, Netlify Forms) before launch.
  -->
  <div class="rounded-lg bg-cream-100 px-4 py-3 text-sm text-charcoal-600">
    Note: This form is not yet connected to a delivery service. Configure before launch.
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="block text-sm font-medium text-charcoal-800">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="mt-1 w-full rounded-lg border border-sage-200 bg-cream-50 px-4 py-2.5 text-charcoal-800 focus:border-sage-500 focus:outline-none focus:ring-1 focus:ring-sage-500"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-charcoal-800">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="mt-1 w-full rounded-lg border border-sage-200 bg-cream-50 px-4 py-2.5 text-charcoal-800 focus:border-sage-500 focus:outline-none focus:ring-1 focus:ring-sage-500"
      />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="phone" class="block text-sm font-medium text-charcoal-800">
        Phone <span class="text-charcoal-400">(optional)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        class="mt-1 w-full rounded-lg border border-sage-200 bg-cream-50 px-4 py-2.5 text-charcoal-800 focus:border-sage-500 focus:outline-none focus:ring-1 focus:ring-sage-500"
      />
    </div>
    <div>
      <label for="interest" class="block text-sm font-medium text-charcoal-800">I'm interested in</label>
      <select
        id="interest"
        name="interest"
        class="mt-1 w-full rounded-lg border border-sage-200 bg-cream-50 px-4 py-2.5 text-charcoal-800 focus:border-sage-500 focus:outline-none focus:ring-1 focus:ring-sage-500"
      >
        <option value="buying">Buying</option>
        <option value="selling">Selling</option>
        <option value="both">Both</option>
        <option value="question">Just a question</option>
      </select>
    </div>
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-charcoal-800">Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="mt-1 w-full rounded-lg border border-sage-200 bg-cream-50 px-4 py-2.5 text-charcoal-800 focus:border-sage-500 focus:outline-none focus:ring-1 focus:ring-sage-500"
    ></textarea>
  </div>

  <Button type="submit" variant="primary">Send Message</Button>
</form>
