---
import { navLinks } from '../config/site';
import Button from './Button.astro';
import MobileMenu from './MobileMenu.astro';
---
<header
  id="site-header"
  class="sticky top-0 z-30 border-b border-sage-100 bg-cream-50/90 backdrop-blur transition-shadow"
>
  <!-- Scroll progress bar -->
  <div
    id="scroll-progress"
    class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-sage-500"
    style="will-change: transform;"
    aria-hidden="true"
  ></div>

  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="#top" class="font-serif text-2xl font-semibold text-sage-800 hover:text-sage-700">
      Silvia Ly
    </a>

    <nav id="primary-nav" class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav={link.href}
            class="nav-link relative text-sm text-charcoal-700 transition-colors hover:text-sage-700"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <Button href="#contact" variant="primary">Talk with Silvia</Button>
    </div>

    <button
      id="mobile-menu-open"
      class="rounded-full p-2 text-charcoal-800 hover:bg-sage-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-500 lg:hidden"
      aria-label="Open menu"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </div>

  <MobileMenu />
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background-color: theme('colors.sage.500');
    transition: transform 0.25s ease;
  }
  .nav-link.active {
    color: theme('colors.sage.700');
    font-weight: 500;
  }
  .nav-link.active::after {
    transform: scaleX(1);
  }
</style>

<script>
  // Header shadow + scroll progress bar
  const header = document.getElementById('site-header');
  const progress = document.getElementById('scroll-progress');

  const onScroll = () => {
    const y = window.scrollY;
    if (y > 8) header?.classList.add('shadow-sm');
    else header?.classList.remove('shadow-sm');

    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? y / max : 0;
      progress.style.transform = `scaleX(${ratio})`;
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scrollspy — highlight the nav link for the section currently in view
  const navLinksEls = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#primary-nav .nav-link'),
  );
  const sectionIds = navLinksEls
    .map((a) => a.getAttribute('data-nav') || '')
    .filter((h) => h.startsWith('#'))
    .map((h) => h.slice(1));

  const setActive = (id: string) => {
    navLinksEls.forEach((a) => {
      a.classList.toggle('active', a.getAttribute('data-nav') === `#${id}`);
    });
  };

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });
</script>
