---
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---
<ol class="relative space-y-8">
  <!-- vertical connector (desktop) -->
  <div class="absolute left-5 top-2 hidden h-[calc(100%-2rem)] w-px bg-sage-200 sm:block" aria-hidden="true"></div>
  {
    steps.map((step, i) => (
      <li class="relative flex gap-5">
        <span class="z-10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-sage-600 font-serif text-lg text-cream-50">
          {i + 1}
        </span>
        <div class="pt-1">
          <h3 class="font-serif text-xl text-sage-900">{step.title}</h3>
          <p class="mt-1 text-charcoal-700">{step.description}</p>
        </div>
      </li>
    ))
  }
</ol>
