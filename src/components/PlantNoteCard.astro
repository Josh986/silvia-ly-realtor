---
interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: Date;
}

const { title, excerpt, category, date } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<article class="flex h-full flex-col rounded-2xl border border-sage-100 bg-cream-50 p-6 shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2 text-sage-600">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 20A7 7 0 0 1 4 13c0-5 4-9 9-11 1 6-1 12-2 18z" />
      <path d="M11 20c0-4 2-8 6-10" />
    </svg>
    <span class="text-xs font-medium uppercase tracking-wider">{category}</span>
  </div>
  <h3 class="mt-3 font-serif text-xl leading-snug text-sage-900">{title}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-charcoal-700">{excerpt}</p>
  <time datetime={date.toISOString()} class="mt-4 text-xs text-charcoal-500">{formattedDate}</time>
</article>
