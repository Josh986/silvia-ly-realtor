---
import { siteConfig, navLinks } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-sage-100 bg-sage-800 text-cream-100">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <p class="font-serif text-2xl text-cream-50">Silvia Ly</p>
        <p class="mt-3 max-w-sm text-sm text-cream-200">{siteConfig.tagline}</p>
        <a
          href={siteConfig.contact.har}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block text-sm text-cream-100 underline underline-offset-4 hover:text-cream-50"
        >
          View Silvia's HAR profile
        </a>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-cream-200">Explore</h3>
        <ul class="mt-4 space-y-2">
          {
            navLinks.slice(0, 4).map((link) => (
              <li>
                <a href={link.href} class="text-sm text-cream-100 hover:text-cream-50">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-cream-200">More</h3>
        <ul class="mt-4 space-y-2">
          {
            navLinks.slice(4).map((link) => (
              <li>
                <a href={link.href} class="text-sm text-cream-100 hover:text-cream-50">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-sage-700 pt-8 text-xs text-cream-200">
      <p>
        Brokerage: <span set:html={siteConfig.brokerage.name} /> &middot; TX License:
        <span set:html={siteConfig.brokerage.license} />
      </p>
      <p class="mt-2">
        Equal Housing Opportunity. <!-- PLACEHOLDER: Add Equal Housing / brokerage disclosures -->
      </p>
      <div class="mt-4 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
        <p>&copy; {year} Silvia Ly. All rights reserved.</p>
        <!-- PLACEHOLDER: Link this to a real Privacy Policy page once created. -->
        <span class="text-cream-300">Privacy Policy coming soon</span>
      </div>
    </div>
  </div>
</footer>
