---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  type?: 'button' | 'submit';
  class?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  target,
  rel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-medium tracking-wide transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-sage-500';

const variants = {
  primary: 'bg-sage-600 text-cream-50 hover:bg-sage-700',
  secondary: 'bg-terracotta-500 text-cream-50 hover:bg-terracotta-600',
  outline: 'border border-sage-600 text-sage-700 hover:bg-sage-50',
};

const classes = `${base} ${variants[variant]} ${className}`;
---
{
  href ? (
    <a href={href} class={classes} target={target} rel={rel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
