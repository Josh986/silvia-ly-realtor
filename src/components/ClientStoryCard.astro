---
interface Props {
  displayName: string;
  neighborhood: string;
  category: string;
  quote: string;
  image?: string | null;
}

const { displayName, neighborhood, category, quote, image } = Astro.props;
const imgSrc = image ?? '/images/placeholders/client-placeholder.svg';
---
<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-sage-100 bg-cream-50 shadow-sm transition-shadow hover:shadow-md"
  data-category={category}
>
  <div class="aspect-[3/2] overflow-hidden bg-cream-100">
    <img
      src={imgSrc}
      alt={`Story of ${displayName} in ${neighborhood}`}
      loading="lazy"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <span
      class="mb-3 inline-block w-fit rounded-full bg-sage-100 px-3 py-1 text-xs font-medium text-sage-700"
    >
      {category}
    </span>
    <h3 class="font-serif text-xl text-sage-900">{displayName}</h3>
    <p class="mt-1 text-sm text-charcoal-500">{neighborhood}</p>
    <blockquote class="mt-4 flex-1 text-charcoal-700">
      <p class="italic leading-relaxed">&ldquo;{quote}&rdquo;</p>
    </blockquote>
  </div>
</article>
