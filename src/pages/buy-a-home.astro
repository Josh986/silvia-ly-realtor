---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import { siteConfig } from '../config/site';

const buyerTypes = [
  { title: 'First-time buyers', desc: 'New to the process and want a patient, clear guide.' },
  { title: 'Growing families', desc: 'Ready for more space, better schools, or a bigger yard.' },
  { title: 'New to Houston', desc: 'Relocating and getting to know the area for the first time.' },
  { title: 'Move-up buyers', desc: 'Looking for the next chapter after your starter home.' },
];

const steps = [
  { title: 'Let\'s talk', description: 'We start with a relaxed conversation about your goals, timeline, and what home means to you.' },
  { title: 'Get ready', description: 'I\'ll connect you with trusted lenders and help you understand your budget and options.' },
  { title: 'Find the one', description: 'We tour homes together, and I\'ll help you see the details that matter most.' },
  { title: 'Make an offer', description: 'I\'ll guide you through a strong, thoughtful offer and negotiate on your behalf.' },
  { title: 'Welcome home', description: 'From inspection to closing, I\'ll be with you every step until you have the keys.' },
];
---
<Layout
  title="Buy a Home"
  description="A patient, supportive home-buying experience in Houston with Silvia Ly, Texas REALTOR®."
>
  <section class="bg-sage-50/60">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <h1 class="font-serif text-4xl text-sage-900 sm:text-5xl">Let's find the place you'll call home.</h1>
      <p class="mt-6 text-lg text-charcoal-700">
        Buying a home should feel exciting, not overwhelming. I'll help you move at your own pace and
        make confident decisions along the way.
      </p>
      <div class="mt-8"><Button href="/contact" variant="primary">Start the Conversation</Button></div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-center font-serif text-3xl text-sage-900">Who I love to help</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        buyerTypes.map((t) => (
          <div class="rounded-2xl border border-sage-100 bg-cream-50 p-6 shadow-sm">
            <h3 class="font-serif text-xl text-sage-900">{t.title}</h3>
            <p class="mt-2 text-sm text-charcoal-700">{t.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-cream-100/60 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-3xl text-sage-900">How the journey works</h2>
      <p class="mt-4 text-charcoal-700">A simple, supportive path from first hello to closing day.</p>
      <div class="mt-10"><ProcessTimeline steps={steps} /></div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-3">
      <div class="rounded-xl bg-sage-50 p-5 text-center">
        <p class="font-serif text-lg text-sage-800">No pressure</p>
        <p class="mt-1 text-sm text-charcoal-600">We move at your pace, always.</p>
      </div>
      <div class="rounded-xl bg-sage-50 p-5 text-center">
        <p class="font-serif text-lg text-sage-800">Clear guidance</p>
        <p class="mt-1 text-sm text-charcoal-600">You'll always know what's next.</p>
      </div>
      <div class="rounded-xl bg-sage-50 p-5 text-center">
        <p class="font-serif text-lg text-sage-800">A true advocate</p>
        <p class="mt-1 text-sm text-charcoal-600">Your family's interests come first.</p>
      </div>
    </div>
  </section>

  <section class="bg-sage-800 py-16 text-center text-cream-50">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-3xl">Ready when you are.</h2>
      <div class="mt-8 flex justify-center gap-4">
        <Button href="/contact" variant="primary">Talk with Silvia</Button>
        <Button
          href={siteConfig.contact.har}
          variant="outline"
          class="border-cream-100 text-cream-50 hover:bg-sage-700"
          target="_blank"
          rel="noopener noreferrer"
        >
          View HAR Profile
        </Button>
      </div>
    </div>
  </section>
</Layout>
