---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PlantNoteCard from '../components/PlantNoteCard.astro';

const notes = (await getCollection('plant-notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout
  title="Plant Notes & Local Favorites"
  description="Gentle notes on homes, plants, and settling into Houston — from Silvia Ly."
>
  <section class="bg-sage-50/60">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <h1 class="font-serif text-4xl text-sage-900 sm:text-5xl">Plant Notes</h1>
      <p class="mt-6 text-lg text-charcoal-700">
        A little corner for the things I notice — about homes, plants, and what makes a house feel
        like it's truly yours.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        notes.map((note) => (
          <PlantNoteCard
            title={note.data.title}
            excerpt={note.data.excerpt}
            category={note.data.category}
            date={note.data.date}
          />
        ))
      }
    </div>

    <p class="mt-12 text-center text-charcoal-500">More notes coming soon.</p>
  </section>
</Layout>
